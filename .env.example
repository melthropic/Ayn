# Demo access gate (optional). When set, the dashboard and API need this password; the home page stays public.
# Sessions are signed with AYN_SESSION_SECRET, or the password itself if unset.
AYN_DEMO_PASSWORD=
AYN_SESSION_SECRET=

# Ask Ayn — free key from https://console.groq.com/keys
GROQ_API_KEY=

# Supabase live mode (optional). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: the simulator and crew alert records. Never expose this to the
# browser (no NEXT_PUBLIC_ prefix) or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Notify crew (optional). Bot token from @BotFather; chat id from /api/notify/setup.
# Run supabase/notifications.sql so acknowledgements show on the dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional overrides
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3
# GROQ_CORRECT_MODEL=openai/gpt-oss-20b
# NEXT_PUBLIC_AYN_API=http://localhost:8000
